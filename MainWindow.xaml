<Window x:Class="ExamAnswerSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExamAnswerSheet"
        Title="Exam Answer Sheet" Width="960" Height="640" MinWidth="780" MinHeight="480"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ======== The answer controls for ONE item (letters / ordering box / allow-deny).
                      Reused by the PBQ items and by the grid rows. DataContext = AnswerItem ======== -->
        <DataTemplate x:Key="AnswerInput">
            <StackPanel Orientation="Horizontal">

                <!-- ordering field: type letters or click them below -->
                <TextBox Text="{Binding OrderText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsLocked}" CharacterCasing="Upper"
                         Width="150" Height="38" Margin="0,0,10,0" Padding="6,0"
                         VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="18"
                         Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextFg}"
                         BorderBrush="{DynamicResource BorderBr}" CaretBrush="{DynamicResource TextFg}"
                         Visibility="{Binding IsOrder, Converter={StaticResource BoolToVis}}"/>

                <!-- letter buttons (also used as click-to-order buttons) -->
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Letter}" Style="{StaticResource OptionButton}"
                                    Click="Option_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="←" Style="{StaticResource ActionButton}" Width="42" Height="38" Padding="0"
                        ToolTip="Remove last letter" Click="OrderBack_Click"
                        Visibility="{Binding IsOrder, Converter={StaticResource BoolToVis}}"/>

                <!-- Allow / Deny dropdown -->
                <ComboBox ItemsSource="{x:Static local:AnswerItem.AllowDenyChoices}"
                          SelectedItem="{Binding AllowDeny}" Width="110" Height="38" FontSize="15"
                          Foreground="#1B2330" VerticalContentAlignment="Center"
                          Visibility="{Binding IsAllowDeny, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ======== PBQ block (Question 1-5) ======== -->
        <DataTemplate DataType="{x:Type local:PbqGroup}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border CornerRadius="5" Background="{DynamicResource Accent}" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="PBQ" FontWeight="Bold" Foreground="{DynamicResource AccentFg}"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="10,0,0,0"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,8" Padding="8" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBr}">
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsEditable}">
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="15"
                                               Width="36" VerticalAlignment="Center"/>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AnswerInput}"
                                                    VerticalAlignment="Center"/>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Opacity" Value="0.7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- ======== One grid question row ======== -->
        <DataTemplate DataType="{x:Type local:AnswerItem}">
            <Grid IsEnabled="{Binding IsEditable}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Maybe}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource MaybeBr}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Idk}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource IdkBr}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource AnswerInput}"
                                VerticalAlignment="Center"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Multi" Style="{StaticResource ChipCheck}" Tag="{DynamicResource Accent}"
                              IsChecked="{Binding Multi}" ToolTip="Allow more than one letter for this question"/>
                    <CheckBox Content="IDK" Style="{StaticResource ChipCheck}" Tag="{DynamicResource IdkBr}"
                              IsChecked="{Binding Idk}" ToolTip="I don't know the concept (I)"/>
                    <CheckBox Content="MAYBE" Style="{StaticResource ChipCheck}" Tag="{DynamicResource MaybeBr}"
                              IsChecked="{Binding Maybe}" ToolTip="Not sure about my choice (M)"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- top bar -->
            <RowDefinition Height="Auto"/>   <!-- stats + filters -->
            <RowDefinition Height="*"/>      <!-- answer list (+ results overlay) -->
            <RowDefinition Height="Auto"/>   <!-- bottom bar with Finish -->
        </Grid.RowDefinitions>

        <!-- ================= TOP BAR ================= -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBr}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File menu (a popup so it follows the light/dark theme) -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button x:Name="MenuBtn" Content="File  ▾" Style="{StaticResource ActionButton}"
                            Height="40" MinWidth="86" Click="MenuBtn_Click"/>
                    <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuBtn}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBr}"
                                BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,4,10,10">
                            <StackPanel MinWidth="230">
                                <Button Style="{StaticResource MenuItemButton}" Content="Export to TXT…" Click="Menu_Export"/>
                                <Button Style="{StaticResource MenuItemButton}" Content="Copy to clipboard" Click="Menu_Copy"/>
                                <Border Height="1" Background="{DynamicResource BorderBr}" Margin="4,4"/>
                                <Button Style="{StaticResource MenuItemButton}" Content="Open exams folder" Click="Menu_OpenExamsFolder"/>
                                <Button Style="{StaticResource MenuItemButton}" Content="New exam…" Click="NewExam_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Timer -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="TIME LEFT" FontSize="11" Foreground="{DynamicResource SubtleFg}"/>
                        <TextBlock x:Name="RemainingText" Text="90:00" FontSize="34" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="{DynamicResource TextFg}"/>
                    </StackPanel>
                    <StackPanel Margin="18,0,0,2" VerticalAlignment="Bottom">
                        <TextBlock Text="ELAPSED" FontSize="11" Foreground="{DynamicResource SubtleFg}"/>
                        <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="20" FontFamily="Consolas"/>
                    </StackPanel>
                    <TextBlock x:Name="TimeUpText" Text="TIME IS UP" Visibility="Collapsed" FontSize="18"
                               FontWeight="Bold" Foreground="{DynamicResource WarnBr}"
                               VerticalAlignment="Center" Margin="18,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="StartBtn" Content="Start" Style="{StaticResource PrimaryButton}"
                            Height="40" MinWidth="80" Click="Start_Click"/>
                    <Button x:Name="PauseBtn" Content="Pause" Style="{StaticResource ActionButton}"
                            Height="40" MinWidth="80" Margin="8,0,0,0" Click="Pause_Click"/>
                    <Button x:Name="ResetBtn" Content="Reset" Style="{StaticResource ActionButton}"
                            Height="40" MinWidth="80" Margin="8,0,0,0" Click="Reset_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeBtn" Content="Dark" Style="{StaticResource ActionButton}" Height="40"
                            MinWidth="80" Click="Theme_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= COUNTERS + PROGRESS + FILTERS ================= -->
        <Grid Grid.Row="1" Margin="14,12,14,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="AnsweredText" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UnansweredText" FontSize="15" FontWeight="SemiBold" Margin="22,0,0,0"/>
                    <TextBlock x:Name="IdkText" FontSize="15" FontWeight="SemiBold" Margin="22,0,0,0"
                               Foreground="{DynamicResource IdkBr}"/>
                    <TextBlock x:Name="MaybeText" FontSize="15" FontWeight="SemiBold" Margin="22,0,0,0"
                               Foreground="{DynamicResource MaybeBr}"/>
                </StackPanel>
                <ProgressBar x:Name="Progress" Height="10" Margin="0,8,24,0" BorderThickness="0"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource ButtonBg}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="FilterAll" Content="All" Tag="All" IsChecked="True" GroupName="Filter"
                             Style="{StaticResource ChipRadio}" Click="Filter_Click"/>
                <RadioButton Content="Unanswered" Tag="Unanswered" GroupName="Filter"
                             Style="{StaticResource ChipRadio}" Click="Filter_Click"/>
                <RadioButton Content="IDK" Tag="IDK" GroupName="Filter"
                             Style="{StaticResource ChipRadio}" Click="Filter_Click"/>
                <RadioButton Content="MAYBE" Tag="MAYBE" GroupName="Filter"
                             Style="{StaticResource ChipRadio}" Click="Filter_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= ANSWER LIST ================= -->
        <ListBox x:Name="AnswerList" Grid.Row="2" Margin="14,10,14,10" Background="Transparent"
                 BorderThickness="0" Foreground="{DynamicResource TextFg}"
                 ItemContainerStyle="{StaticResource RowItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 GotKeyboardFocus="AnswerList_GotKeyboardFocus"/>

        <!-- ================= RESULTS PANEL (shown after Finish) ================= -->
        <Grid x:Name="ResultsOverlay" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource OverlayBg}">
            <Border Width="640" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBr}"
                    BorderThickness="1" CornerRadius="14" Padding="26">
                <StackPanel>
                    <TextBlock Text="Exam finished" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Saved to" Margin="0,16,0,2" FontSize="12" Foreground="{DynamicResource SubtleFg}"/>
                    <TextBox x:Name="PathText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource TextFg}"
                             FontFamily="Consolas" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open file" Style="{StaticResource PrimaryButton}" Height="40" MinWidth="110"
                                Click="OpenFile_Click"/>
                        <Button Content="Open folder" Style="{StaticResource ActionButton}" Height="40" MinWidth="110"
                                Margin="8,0,0,0" Click="OpenFolder_Click"/>
                        <Button Content="Copy to clipboard" Style="{StaticResource ActionButton}" Height="40" MinWidth="140"
                                Margin="8,0,0,0" Click="CopyResults_Click"/>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource BorderBr}" Margin="0,20,0,16"/>
                    <TextBlock x:Name="SummaryText" FontSize="16" LineHeight="26"/>
                    <TextBlock x:Name="ResultsStatus" Margin="0,8,0,0" Foreground="{DynamicResource GoodBr}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Review answers" Style="{StaticResource ActionButton}" Height="40"
                                MinWidth="140" Click="Review_Click"/>
                        <Button Content="New exam…" Style="{StaticResource ActionButton}" Height="40"
                                MinWidth="120" Margin="8,0,0,0" Click="NewExam_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= BOTTOM BAR ================= -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBr}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="ModeText" Text="Review mode: the exam is finished and the answers are locked."
                               Visibility="Collapsed" FontWeight="SemiBold" Foreground="{DynamicResource WarnBr}"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource SubtleFg}"/>
                    <TextBlock Text="Keys: A–E answer · ↑ ↓ move · I = IDK · M = MAYBE · Delete = clear row"
                               FontSize="12" Foreground="{DynamicResource SubtleFg}"/>
                </StackPanel>
                <Button x:Name="FinishBtn" Content="FINISH EXAM" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}" FontSize="20" Height="54" MinWidth="240"
                        Click="Finish_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
