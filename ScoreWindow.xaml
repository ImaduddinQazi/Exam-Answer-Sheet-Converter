<Window x:Class="ExamAnswerSheet.ScoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Score" Width="660" Height="700" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryBlock" FontSize="15" LineHeight="24" FontFamily="Consolas"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <Grid Grid.Row="1" Margin="10,0,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Q" FontWeight="Bold" Foreground="{DynamicResource SubtleFg}"/>
            <TextBlock Grid.Column="1" Text="Your answer" FontWeight="Bold" Foreground="{DynamicResource SubtleFg}"/>
            <TextBlock Grid.Column="2" Text="Correct answer" FontWeight="Bold" Foreground="{DynamicResource SubtleFg}"/>
            <TextBlock Grid.Column="3" Text="Result" FontWeight="Bold" Foreground="{DynamicResource SubtleFg}"/>
            <TextBlock Grid.Column="4" Text="Flag" FontWeight="Bold" Foreground="{DynamicResource SubtleFg}"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,6" Margin="0,0,0,3" CornerRadius="6" Background="{DynamicResource CardBg}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Id}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Yours}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Correct}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Result}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result}" Value="Correct">
                                                    <Setter Property="Foreground" Value="{DynamicResource GoodBr}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="Wrong">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBr}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Text="{Binding Flag}" Foreground="{DynamicResource SubtleFg}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Close" Style="{StaticResource ActionButton}" Height="40" MinWidth="110"
                HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click"/>
    </Grid>
</Window>
